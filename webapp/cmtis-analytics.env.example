# ═══════════════════════════════════════════════════════════════
# CmtisEdu Analytics — переменные окружения
#
# Установка:
#   sudo cp cmtis-analytics.env.example /etc/cmtis-analytics.env
#   sudo chown root:root /etc/cmtis-analytics.env
#   sudo chmod 600 /etc/cmtis-analytics.env
#   # затем отредактируйте значения ниже
# ═══════════════════════════════════════════════════════════════

# ─── Веб-приложение ───────────────────────────────────────────
CMTIS_APP_PORT=8000

# ─── Подключение к MariaDB Moodle ─────────────────────────────
# Read-only пользователь (создаётся на стороне БД:
#   CREATE USER 'analytics_ro'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT ON moodle.* TO 'analytics_ro'@'localhost';)
CMTIS_DB_HOST=127.0.0.1
CMTIS_DB_PORT=3306
CMTIS_DB_USER=analytics_ro
CMTIS_DB_PASSWORD=ЗАМЕНИТЕ_НА_ПАРОЛЬ_БД
CMTIS_DB_NAME=moodle
